[Unit]
Description=Xandora RFID Reader Bridge (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=Xandora
Group=Xandora
WorkingDirectory=/opt/rfid-middleware
EnvironmentFile=/etc/xandora-reader/%i.env
ExecStart=/usr/bin/node /opt/rfid-middleware/xandora-llrp-bridge.js
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
