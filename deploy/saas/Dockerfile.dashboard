FROM node:20-alpine AS build

WORKDIR /app

COPY rfid-dashboard/package*.json ./
RUN npm ci

COPY rfid-dashboard ./
RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/saas/nginx-dashboard.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
