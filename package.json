{
  "name": "rfid-middleware",
  "version": "1.0.0",
  "description": "",
  "main": "functions/index.js",
  "scripts": {
    "start": "node backend/server.js",
    "start:dev": "nodemon --watch backend --watch src -e js,json --exec \"node backend/server.js\"",
    "worker": "node backend/worker.js",
    "reader:bridge": "node xandora-llrp-bridge.js",
    "reader:pm2": "pm2 start ecosystem.readers.config.cjs",
    "reader:pm2:start": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-readers-pm2.ps1",
    "reader:pm2:startup": "powershell -ExecutionPolicy Bypass -File .\\scripts\\register-reader-pm2-startup.ps1",
    "reader:pm2:startup-shortcut": "powershell -ExecutionPolicy Bypass -File .\\scripts\\register-reader-startup-shortcut.ps1",
    "migrate": "node scripts/run_migrations.js",
    "dashboard": "cd rfid-dashboard && npm run dev -- --host",
    "onprem:install": "powershell -ExecutionPolicy Bypass -File .\\scripts\\install-onprem.ps1",
    "onprem:update": "powershell -ExecutionPolicy Bypass -File .\\scripts\\update-onprem.ps1",
    "onprem:backup": "powershell -ExecutionPolicy Bypass -File .\\scripts\\backup-onprem.ps1",
    "bootstrap:master": "node scripts/bootstrap_master_admin.js",
    "bootstrap:e2e": "node scripts/bootstrap_e2e_accounts.js",
    "bootstrap:demo": "node scripts/bootstrap_demo_smoke.js",
    "smoke:demo": "node scripts/demo_smoke_test.js",
    "retention:dry-run": "node scripts/run_retention_once.js",
    "retention:apply": "node scripts/run_retention_once.js --apply",
    "saas:up": "docker compose -f deploy/saas/docker-compose.saas.yml --env-file deploy/saas/.env.saas up -d --build",
    "saas:down": "docker compose -f deploy/saas/docker-compose.saas.yml --env-file deploy/saas/.env.saas down",
    "saas:logs": "docker compose -f deploy/saas/docker-compose.saas.yml --env-file deploy/saas/.env.saas logs -f api worker edge",
    "test": "jest --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^0.10.9",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase-functions": "^7.2.5",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.3",
    "llrp": "^0.0.1",
    "luxon": "^3.7.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.15.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.11",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "redis": "^5.9.0",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "pm2": "^6.0.14",
    "postcss": "^8.5.6",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.15"
  }
}
