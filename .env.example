NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=false
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/rfid
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=rfid
JWT_SECRET=change_me
JWT_EXPIRES_IN=30d
SCAN_API_KEY=change_me
POS_API_KEY=change_me
DEVICE_API_KEY=change_me
# Bridge: STORE_TOKEN mode (multi-reader) — set STORE_TOKEN only, omit READER_HOST
# The bridge will fetch all registered readers from the backend automatically.
STORE_TOKEN=
# Bridge: single-reader mode (legacy) — set READER_HOST/DEVICE_ID/ZONE_ID
READER_HOST=192.168.100.50
READER_PORT=5084
DEVICE_ID=FX9600_01
STORE_ID=STORE_001
XANDORA_HOST=127.0.0.1
XANDORA_PORT=3000
XANDORA_BASE_URL=
SCAN_PATH=/api/v1/scans/batch
EVENTS_PATH=/api/v1/events/ingest
ZONE_ID=sales_floor
API_BODY_LIMIT=5mb
LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX=10
ADMIN_WRITE_RATE_LIMIT_WINDOW_MS=60000
ADMIN_WRITE_RATE_LIMIT_MAX=120
RABBITMQ_URL=amqp://guest:guest@localhost:5672
DISABLE_RABBIT=0
DISABLE_REDIS=0
RUNTIME_ALERTS_ENABLED=1
RUNTIME_ALERT_REPEAT_UPDATE_ENABLED=0
RUNTIME_ALERT_TOUCH_WINDOW_MS=5000
RUNTIME_CHANGING_SWEEP_MS=15000
RUNTIME_DB_LOCK_TIMEOUT_MS=120
DATA_RETENTION_ENABLED=0
DATA_RETENTION_DRY_RUN=1
DATA_RETENTION_CRON=35 2 * * *
SCAN_ITEM_RETENTION_DAYS=30
SCAN_BATCH_RETENTION_DAYS=30
COMPLETED_SESSION_RETENTION_DAYS=180
POS_TRANSACTION_RETENTION_DAYS=365
RESOLVED_ALERT_RETENTION_DAYS=90
ACTIVITY_AUDIT_RETENTION_DAYS=180
RECENT_EVENTS_RETENTION_DAYS=7
